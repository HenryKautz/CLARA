;; grid3x3-3
;; 3 x 3 grid of places, roads between adjacent cells;
;; no airports;
;; 1 truck at the origin p1-1, 0 airplanes over the airports.
;; No packages: the goal sends each truck to a destination.
;; Every destination is at least 3 steps from the origin by road (3 places qualify).
;; 2 destinations per truck; reaching any one of them counts.
;;
;; Generated by ppgen.sh -- edit the generator, not this file.
;; Every setting used, defaults included; re-run with these to reproduce it:
;;
;;   --style grid
;;   --dimensions 3 3
;;   --airports 0
;;   --trucks 1
;;   --airplanes 0
;;   --packages 0
;;   --drive-cost 1
;;   --fly-cost 3
;;   --preferences none
;;   --destinations 2
;;   --require all
;;   --mindist 3
;;   --seed 3

(define (problem grid3x3-3)
  (:domain clara-logistics-old)

  (:objects
        p1-1 p1-2 p1-3 p2-1 p2-2 p2-3 p3-1 p3-2 p3-3 - place
        truck1 - truck)

  (:init
        ;; where everything starts
        (at truck1 p1-1)

        ;; static topology: roads within each road network,
        ;; routes between every pair of airports
        (road p2-1 p1-1)
        (road p1-1 p2-1)
        (road p1-2 p1-1)
        (road p1-1 p1-2)
        (road p2-2 p1-2)
        (road p1-2 p2-2)
        (road p1-3 p1-2)
        (road p1-2 p1-3)
        (road p2-3 p1-3)
        (road p1-3 p2-3)
        (road p3-1 p2-1)
        (road p2-1 p3-1)
        (road p2-2 p2-1)
        (road p2-1 p2-2)
        (road p3-2 p2-2)
        (road p2-2 p3-2)
        (road p2-3 p2-2)
        (road p2-2 p2-3)
        (road p3-3 p2-3)
        (road p2-3 p3-3)
        (road p3-2 p3-1)
        (road p3-1 p3-2)
        (road p3-3 p3-2)
        (road p3-2 p3-3)


        ;; travel prices: one value for every drive, one for every flight
        (= (total-cost) 0)
        (= (drive-cost) 1)
        (= (fly-cost) 3))

  (:goal (and
        (or (at truck1 p2-3) (at truck1 p3-3))))

  (:metric minimize (total-cost)))
