;; grid7x7-1-pkg2-p4-1
;; Clamped variant of grid7x7-1.pddl: the hard goal is (at pkg2 p4-1) only;
;; the 12 goal preferences (utility 8 each) are kept.

(define (problem grid7x7-1-pkg2-p4-1)
  (:domain clara-logistics-handling)

  (:objects
        p1-1 p1-2 p1-3 p1-4 p1-5 p1-6 p1-7 p2-1 p2-2 p2-3 p2-4 p2-5 p2-6 p2-7 p3-1 p3-2 p3-3 p3-4 p3-5 p3-6 p3-7 p4-1 p4-2 p4-3 p4-4 p4-5 p4-6 p4-7 p5-1 p5-2 p5-3 p5-4 p5-5 p5-6 p5-7 p6-1 p6-2 p6-3 p6-4 p6-5 p6-6 p6-7 p7-1 p7-2 p7-3 p7-4 p7-5 p7-6 p7-7 - place
        truck1 truck2 - truck
        pkg1 pkg2 pkg3 pkg4 - package)

  (:init
        ;; where everything starts
        (at pkg1 p2-6)
        (at pkg2 p2-2)
        (at pkg3 p2-3)
        (at pkg4 p2-5)
        (at truck1 p6-3)
        (at truck2 p7-2)

        ;; static topology: roads within each road network,
        ;; routes between every pair of airports
        (road p1-2 p1-1)
        (road p1-1 p1-2)
        (road p2-2 p1-2)
        (road p1-2 p2-2)
        (road p1-3 p1-2)
        (road p1-2 p1-3)
        (road p2-3 p1-3)
        (road p1-3 p2-3)
        (road p2-4 p1-4)
        (road p1-4 p2-4)
        (road p1-5 p1-4)
        (road p1-4 p1-5)
        (road p2-5 p1-5)
        (road p1-5 p2-5)
        (road p1-6 p1-5)
        (road p1-5 p1-6)
        (road p1-7 p1-6)
        (road p1-6 p1-7)
        (road p3-1 p2-1)
        (road p2-1 p3-1)
        (road p2-3 p2-2)
        (road p2-2 p2-3)
        (road p2-4 p2-3)
        (road p2-3 p2-4)
        (road p3-4 p2-4)
        (road p2-4 p3-4)
        (road p3-5 p2-5)
        (road p2-5 p3-5)
        (road p2-6 p2-5)
        (road p2-5 p2-6)
        (road p2-7 p2-6)
        (road p2-6 p2-7)
        (road p3-2 p3-1)
        (road p3-1 p3-2)
        (road p3-3 p3-2)
        (road p3-2 p3-3)
        (road p4-3 p3-3)
        (road p3-3 p4-3)
        (road p3-4 p3-3)
        (road p3-3 p3-4)
        (road p4-4 p3-4)
        (road p3-4 p4-4)
        (road p4-5 p3-5)
        (road p3-5 p4-5)
        (road p4-6 p3-6)
        (road p3-6 p4-6)
        (road p4-7 p3-7)
        (road p3-7 p4-7)
        (road p5-1 p4-1)
        (road p4-1 p5-1)
        (road p5-2 p4-2)
        (road p4-2 p5-2)
        (road p5-3 p4-3)
        (road p4-3 p5-3)
        (road p5-5 p4-5)
        (road p4-5 p5-5)
        (road p4-6 p4-5)
        (road p4-5 p4-6)
        (road p4-7 p4-6)
        (road p4-6 p4-7)
        (road p5-7 p4-7)
        (road p4-7 p5-7)
        (road p5-2 p5-1)
        (road p5-1 p5-2)
        (road p5-3 p5-2)
        (road p5-2 p5-3)
        (road p6-3 p5-3)
        (road p5-3 p6-3)
        (road p5-4 p5-3)
        (road p5-3 p5-4)
        (road p5-5 p5-4)
        (road p5-4 p5-5)
        (road p5-6 p5-5)
        (road p5-5 p5-6)
        (road p6-6 p5-6)
        (road p5-6 p6-6)
