        (road p6-6 p7-6)
        (road p6-7 p6-6)
        (road p6-6 p6-7)
        (road p7-2 p7-1)
        (road p7-1 p7-2)
        (road p7-5 p7-4)
        (road p7-4 p7-5)
        (road p7-7 p7-6)
        (road p7-6 p7-7)

        ;; travel prices: one value for every drive, one for every flight
        (= (total-cost) 0)
        (= (drive-cost) 2)
        (= (fly-cost) 3))

  (:goal (and
        (at pkg2 p4-1)
        (preference deliver-pkg1-1 (at pkg1 p5-4) 8)
        (preference deliver-pkg1-2 (at pkg1 p1-3) 8)
        (preference deliver-pkg1-3 (at pkg1 p7-4) 8)
        (preference deliver-pkg2-1 (at pkg2 p5-2) 8)
