        (preference deliver-pkg3-1 (at pkg3 p3-3) 8)
        (preference deliver-pkg3-2 (at pkg3 p5-7) 8)
        (preference deliver-pkg3-3 (at pkg3 p6-1) 8)
        (preference deliver-pkg4-1 (at pkg4 p7-1) 8)
        (preference deliver-pkg4-2 (at pkg4 p4-5) 8)
        (preference deliver-pkg4-3 (at pkg4 p5-3) 8)))

  (:metric minimize (total-cost)))
