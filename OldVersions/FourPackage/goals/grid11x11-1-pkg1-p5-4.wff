      p11-1 p11-2 p11-3 p11-4 p11-5 p11-6 p11-7 p11-8 p11-9 p11-10 p11-11
      truck1 truck2 pkg1 pkg2 pkg3 pkg4))

;; Type domains
(domain airplane (set-difference objects objects))
(domain airport (set-difference objects objects))
(domain package (set pkg1 pkg2 pkg3 pkg4))
