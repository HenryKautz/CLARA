;; grid4x4-1: FiFO encoding of grid4x4-1.pddl, as the CLARA experiments built it
;; (recognize.sh --stop-after scnf; regenerated by make-fifo-files.py).
;; Self-contained: instantiating this file alone gives the clauses of
;; ../scnf/grid4x4-1.scnf.  The horizon:
(option *satplan-numslices* 7)

;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem grid4x4-1 from rec-problem.pddl
;; Domain clara-logistics from clara-logistics.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects
 (set p1-1 p1-2 p1-3 p1-4 p2-1 p2-2 p2-3 p2-4 p3-1 p3-2 p3-3 p3-4 p4-1 p4-2
      p4-3 p4-4 truck1))

;; Type domains
(domain airplane (set-difference objects objects))
(domain airport (set-difference objects objects))
(domain package (set-difference objects objects))
(domain place
 (set p1-1 p1-2 p1-3 p1-4 p2-1 p2-2 p2-3 p2-4 p3-1 p3-2 p3-3 p3-4 p4-1 p4-2
      p4-3 p4-4))
(domain truck (set truck1))
(domain vehicle (set truck1))

;; Static predicates (never added or deleted), with all
;; positive instances from the initial state.  The dummy
;; facts only register each predicate as static.
(static (route pddl2fifo-static-dummy pddl2fifo-static-dummy)
 (road pddl2fifo-static-dummy pddl2fifo-static-dummy) (road p2-1 p1-1)
 (road p1-1 p2-1) (road p1-2 p1-1) (road p1-1 p1-2) (road p2-2 p1-2)
 (road p1-2 p2-2) (road p1-3 p1-2) (road p1-2 p1-3) (road p2-3 p1-3)
 (road p1-3 p2-3) (road p1-4 p1-3) (road p1-3 p1-4) (road p2-4 p1-4)
 (road p1-4 p2-4) (road p3-1 p2-1) (road p2-1 p3-1) (road p2-2 p2-1)
 (road p2-1 p2-2) (road p3-2 p2-2) (road p2-2 p3-2) (road p2-3 p2-2)
 (road p2-2 p2-3) (road p3-3 p2-3) (road p2-3 p3-3) (road p2-4 p2-3)
 (road p2-3 p2-4) (road p3-4 p2-4) (road p2-4 p3-4) (road p4-1 p3-1)
 (road p3-1 p4-1) (road p3-2 p3-1) (road p3-1 p3-2) (road p4-2 p3-2)
 (road p3-2 p4-2) (road p3-3 p3-2) (road p3-2 p3-3) (road p4-3 p3-3)
 (road p3-3 p4-3) (road p3-4 p3-3) (road p3-3 p3-4) (road p4-4 p3-4)
 (road p3-4 p4-4) (road p4-2 p4-1) (road p4-1 p4-2) (road p4-3 p4-2)
 (road p4-2 p4-3) (road p4-4 p4-3) (road p4-3 p4-4))

;; Action preconditions, effects, and costs
(static
 (all obj package true
  (all veh vehicle true
   (all loc place true
    (and (pre (load obj veh loc) (at veh loc))
         (pre (load obj veh loc) (at obj loc))
         (add (load obj veh loc) (in obj veh))
         (del (load obj veh loc) (at obj loc))))))
 (all obj package true
  (all veh vehicle true
   (all loc place true
    (and (pre (unload obj veh loc) (at veh loc))
         (pre (unload obj veh loc) (in obj veh))
         (add (unload obj veh loc) (at obj loc))
         (del (unload obj veh loc) (in obj veh))))))
 (all obj package true
  (all (from to) vehicle true
   (all loc place true
    (and (pre (transfer obj from to loc) (in obj from))
         (pre (transfer obj from to loc) (at from loc))
         (pre (transfer obj from to loc) (at to loc))
         (add (transfer obj from to loc) (in obj to))
         (del (transfer obj from to loc) (in obj from))))))
 (all truck-v truck true
  (all (from to) place true
   (if (and (road from to))
       (and (pre (drive truck-v from to) (at truck-v from))
            (add (drive truck-v from to) (at truck-v to))
            (del (drive truck-v from to) (at truck-v from))
            (cost (drive truck-v from to) 1)))))
 (all airplane-v airplane true
  (all (from to) airport true
   (if (and (route from to))
       (and (pre (fly airplane-v from to) (at airplane-v from))
            (add (fly airplane-v from to) (at airplane-v to))
            (del (fly airplane-v from to) (at airplane-v from))
            (cost (fly airplane-v from to) 3))))))

;; Initial and goal states
(domain initial-state (set (at truck1 p1-1)))
(domain goal-fluents (set (at truck1 p4-3) (at truck1 p4-4) (at truck1 p3-4)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f))
               (union (collect f (del * f))
                      (union initial-state goal-fluents)))))
(domain costs (collect c (cost * c)))
(domain goal-state (set-difference fluents fluents))

;; Goal (disjunctive/nested) asserted directly at the final slice
(or (holds (at truck1 p4-3) numslices) (holds (at truck1 p4-4) numslices)
    (holds (at truck1 p3-4) numslices))

(include "satplan.wff")
