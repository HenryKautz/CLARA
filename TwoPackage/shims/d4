#!/bin/bash
# d4 shim that compile-d4.py puts first on PATH, so FiFO's marginals.sh runs it
# in place of the real d4 (named by D4_REAL).  It runs d4 unchanged and records,
# in D4_LOG_DIR:
#   d4-input.cnf   the DIMACS d4 is given (with FiFO's 'c p show' projection line)
#   d4-start, d4-end   awake-time clock readings, CLOCK_UPTIME_RAW (end only if d4
#                  exits), d4-exit its exit code.  That clock stops while the Mac
#                  sleeps, so a suspend does not inflate d4's time; it is the clock
#                  of Python's time.monotonic() on macOS, which compile-d4.py uses.
#   d4.nnf         a copy of d4's circuit dump (FiFO deletes its own after import)
# and appends the options in D4_EXTRA, if any, to d4's command line.
set -u
log="${D4_LOG_DIR:?D4_LOG_DIR not set}"
real="${D4_REAL:?D4_REAL not set}"
in="" dump=""
for ((i = 1; i <= $#; i++)); do
  case "${!i}" in
    -i|--input) j=$((i + 1)); in="${!j}" ;;
    --dump-file) j=$((i + 1)); dump="${!j}" ;;
  esac
done
[[ -n "$in" ]] && cp "$in" "$log/d4-input.cnf"
now() { python3 -c 'import time; print("%.3f" % time.clock_gettime(time.CLOCK_UPTIME_RAW))'; }
# d4's search recurses deeply on large theories, and the default 8 MB stack
# overflows (a bus error on macOS); take the hard limit (64 MB on macOS).
ulimit -s hard
now > "$log/d4-start"
# D4_EXTRA: extra d4 options (word-split on purpose), appended to FiFO's own
"$real" "$@" ${D4_EXTRA:-}
code=$?
now > "$log/d4-end"
echo "$code" > "$log/d4-exit"
[[ -n "$dump" && -f "$dump" ]] && cp "$dump" "$log/d4.nnf"
exit "$code"
