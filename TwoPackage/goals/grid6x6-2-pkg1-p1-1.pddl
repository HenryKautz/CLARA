;; grid6x6-2-pkg1-p1-1
;; Single-goal variant of grid6x6-2.pddl: the goal is (at pkg1 p1-1) only.
;; 6 x 6 grid of places, roads between adjacent cells;
;; no airports;
;; 1 truck and 2 packages placed at random, 0 airplanes over the airports.
;; 2 destinations per package; reaching any one of them counts.
;; At least one of the 2 packages must reach a destination.
;;

(define (problem grid6x6-2-pkg1-p1-1)
  (:domain clara-logistics-old)

  (:objects
        p1-1 p1-2 p1-3 p1-4 p1-5 p1-6 p2-1 p2-2 p2-3 p2-4 p2-5 p2-6 p3-1 p3-2 p3-3 p3-4 p3-5 p3-6 p4-1 p4-2 p4-3 p4-4 p4-5 p4-6 p5-1 p5-2 p5-3 p5-4 p5-5 p5-6 p6-1 p6-2 p6-3 p6-4 p6-5 p6-6 - place
        truck1 - truck
        pkg1 pkg2 - package)

  (:init
        ;; where everything starts
        (at pkg1 p2-3)
        (at pkg2 p4-5)
        (at truck1 p3-4)

        ;; static topology: roads within each road network,
        ;; routes between every pair of airports
        (road p2-1 p1-1)
        (road p1-1 p2-1)
        (road p1-2 p1-1)
        (road p1-1 p1-2)
        (road p2-2 p1-2)
        (road p1-2 p2-2)
        (road p1-3 p1-2)
        (road p1-2 p1-3)
        (road p2-3 p1-3)
        (road p1-3 p2-3)
        (road p1-4 p1-3)
        (road p1-3 p1-4)
        (road p2-4 p1-4)
        (road p1-4 p2-4)
        (road p1-5 p1-4)
        (road p1-4 p1-5)
        (road p2-5 p1-5)
        (road p1-5 p2-5)
        (road p1-6 p1-5)
        (road p1-5 p1-6)
        (road p2-6 p1-6)
        (road p1-6 p2-6)
        (road p3-1 p2-1)
        (road p2-1 p3-1)
        (road p2-2 p2-1)
        (road p2-1 p2-2)
        (road p3-2 p2-2)
        (road p2-2 p3-2)
        (road p2-3 p2-2)
        (road p2-2 p2-3)
        (road p3-3 p2-3)
        (road p2-3 p3-3)
        (road p2-4 p2-3)
        (road p2-3 p2-4)
        (road p3-4 p2-4)
        (road p2-4 p3-4)
        (road p2-5 p2-4)
        (road p2-4 p2-5)
        (road p3-5 p2-5)
        (road p2-5 p3-5)
        (road p2-6 p2-5)
        (road p2-5 p2-6)
        (road p3-6 p2-6)
        (road p2-6 p3-6)
        (road p4-1 p3-1)
        (road p3-1 p4-1)
        (road p3-2 p3-1)
        (road p3-1 p3-2)
        (road p4-2 p3-2)
        (road p3-2 p4-2)
        (road p3-3 p3-2)
        (road p3-2 p3-3)
        (road p4-3 p3-3)
        (road p3-3 p4-3)
        (road p3-4 p3-3)
        (road p3-3 p3-4)
        (road p4-4 p3-4)
        (road p3-4 p4-4)
        (road p3-5 p3-4)
        (road p3-4 p3-5)
        (road p4-5 p3-5)
        (road p3-5 p4-5)
        (road p3-6 p3-5)
        (road p3-5 p3-6)
        (road p4-6 p3-6)
        (road p3-6 p4-6)
        (road p5-1 p4-1)
        (road p4-1 p5-1)
        (road p4-2 p4-1)
        (road p4-1 p4-2)
        (road p5-2 p4-2)
        (road p4-2 p5-2)
        (road p4-3 p4-2)
        (road p4-2 p4-3)
        (road p5-3 p4-3)
        (road p4-3 p5-3)
        (road p4-4 p4-3)
        (road p4-3 p4-4)
        (road p5-4 p4-4)
        (road p4-4 p5-4)
        (road p4-5 p4-4)
        (road p4-4 p4-5)
        (road p5-5 p4-5)
        (road p4-5 p5-5)
        (road p4-6 p4-5)
        (road p4-5 p4-6)
        (road p5-6 p4-6)
        (road p4-6 p5-6)
        (road p6-1 p5-1)
        (road p5-1 p6-1)
        (road p5-2 p5-1)
        (road p5-1 p5-2)
        (road p6-2 p5-2)
        (road p5-2 p6-2)
        (road p5-3 p5-2)
        (road p5-2 p5-3)
        (road p6-3 p5-3)
        (road p5-3 p6-3)
        (road p5-4 p5-3)
        (road p5-3 p5-4)
        (road p6-4 p5-4)
        (road p5-4 p6-4)
        (road p5-5 p5-4)
        (road p5-4 p5-5)
        (road p6-5 p5-5)
        (road p5-5 p6-5)
        (road p5-6 p5-5)
        (road p5-5 p5-6)
        (road p6-6 p5-6)
        (road p5-6 p6-6)
        (road p6-2 p6-1)
        (road p6-1 p6-2)
        (road p6-3 p6-2)
        (road p6-2 p6-3)
        (road p6-4 p6-3)
        (road p6-3 p6-4)
        (road p6-5 p6-4)
        (road p6-4 p6-5)
        (road p6-6 p6-5)
        (road p6-5 p6-6)


        ;; travel prices: one value for every drive, one for every flight
        (= (total-cost) 0)
        (= (drive-cost) 1)
        (= (fly-cost) 3))

  (:goal (and
        (at pkg1 p1-1)))

  (:metric minimize (total-cost)))
