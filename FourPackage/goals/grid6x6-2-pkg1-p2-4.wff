;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem grid6x6-2-pkg1-p2-4 from grid6x6-2-pkg1-p2-4.pddl
;; Domain clara-logistics-handling from clara-logistics-handling.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects
 (set p1-1 p1-2 p1-3 p1-4 p1-5 p1-6 p2-1 p2-2 p2-3 p2-4 p2-5 p2-6 p3-1 p3-2
      p3-3 p3-4 p3-5 p3-6 p4-1 p4-2 p4-3 p4-4 p4-5 p4-6 p5-1 p5-2 p5-3 p5-4
      p5-5 p5-6 p6-1 p6-2 p6-3 p6-4 p6-5 p6-6 truck1 truck2 pkg1 pkg2 pkg3
      pkg4))

;; Type domains
(domain airplane (set-difference objects objects))
(domain airport (set-difference objects objects))
(domain package (set pkg1 pkg2 pkg3 pkg4))
(domain place
 (set p1-1 p1-2 p1-3 p1-4 p1-5 p1-6 p2-1 p2-2 p2-3 p2-4 p2-5 p2-6 p3-1 p3-2
      p3-3 p3-4 p3-5 p3-6 p4-1 p4-2 p4-3 p4-4 p4-5 p4-6 p5-1 p5-2 p5-3 p5-4
      p5-5 p5-6 p6-1 p6-2 p6-3 p6-4 p6-5 p6-6))
(domain truck (set truck1 truck2))
(domain vehicle (set truck1 truck2))

;; Static predicates (never added or deleted), with all
;; positive instances from the initial state.  The dummy
;; facts only register each predicate as static.
(static (route pddl2fifo-static-dummy pddl2fifo-static-dummy)
 (road pddl2fifo-static-dummy pddl2fifo-static-dummy) (road p2-1 p1-1)
 (road p1-1 p2-1) (road p2-2 p1-2) (road p1-2 p2-2) (road p1-4 p1-3)
 (road p1-3 p1-4) (road p1-5 p1-4) (road p1-4 p1-5) (road p2-5 p1-5)
 (road p1-5 p2-5) (road p2-6 p1-6) (road p1-6 p2-6) (road p3-1 p2-1)
 (road p2-1 p3-1) (road p2-2 p2-1) (road p2-1 p2-2) (road p2-3 p2-2)
 (road p2-2 p2-3) (road p2-4 p2-3) (road p2-3 p2-4) (road p2-5 p2-4)
 (road p2-4 p2-5) (road p2-6 p2-5) (road p2-5 p2-6) (road p3-2 p3-1)
 (road p3-1 p3-2) (road p3-3 p3-2) (road p3-2 p3-3) (road p4-3 p3-3)
 (road p3-3 p4-3) (road p4-4 p3-4) (road p3-4 p4-4) (road p3-5 p3-4)
 (road p3-4 p3-5) (road p4-5 p3-5) (road p3-5 p4-5) (road p4-6 p3-6)
 (road p3-6 p4-6) (road p5-1 p4-1) (road p4-1 p5-1) (road p4-2 p4-1)
 (road p4-1 p4-2) (road p5-2 p4-2) (road p4-2 p5-2) (road p4-3 p4-2)
 (road p4-2 p4-3) (road p5-4 p4-4) (road p4-4 p5-4) (road p5-6 p4-6)
 (road p4-6 p5-6) (road p6-2 p5-2) (road p5-2 p6-2) (road p5-3 p5-2)
 (road p5-2 p5-3) (road p6-3 p5-3) (road p5-3 p6-3) (road p5-4 p5-3)
 (road p5-3 p5-4) (road p6-4 p5-4) (road p5-4 p6-4) (road p6-5 p5-5)
 (road p5-5 p6-5) (road p5-6 p5-5) (road p5-5 p5-6) (road p6-2 p6-1)
 (road p6-1 p6-2) (road p6-3 p6-2) (road p6-2 p6-3) (road p6-5 p6-4)
 (road p6-4 p6-5) (road p6-6 p6-5) (road p6-5 p6-6))

;; Action preconditions, effects, and costs
(static
 (all obj package true
  (all veh vehicle true
   (all loc place true
    (and (pre (load obj veh loc) (at veh loc))
         (pre (load obj veh loc) (at obj loc))
         (add (load obj veh loc) (in obj veh))
         (del (load obj veh loc) (at obj loc)) (cost (load obj veh loc) 1)))))
 (all obj package true
  (all veh vehicle true
   (all loc place true
    (and (pre (unload obj veh loc) (at veh loc))
         (pre (unload obj veh loc) (in obj veh))
         (add (unload obj veh loc) (at obj loc))
         (del (unload obj veh loc) (in obj veh))
         (cost (unload obj veh loc) 1)))))
 (all truck-v truck true
  (all (from to) place true
   (if (and (road from to))
       (and (pre (drive truck-v from to) (at truck-v from))
            (add (drive truck-v from to) (at truck-v to))
            (del (drive truck-v from to) (at truck-v from))
            (cost (drive truck-v from to) 2)))))
 (all airplane-v airplane true
  (all (from to) airport true
   (if (and (route from to))
       (and (pre (fly airplane-v from to) (at airplane-v from))
            (add (fly airplane-v from to) (at airplane-v to))
            (del (fly airplane-v from to) (at airplane-v from))
            (cost (fly airplane-v from to) 3))))))

;; Initial and goal states
(domain initial-state
 (set (at pkg1 p4-5) (at pkg2 p4-1) (at pkg3 p2-6) (at pkg4 p2-2)
      (at truck1 p3-4) (at truck2 p2-3)))
(domain goal-state (set (at pkg1 p2-4)))
(domain pref-fluents
 (set (at pkg1 p5-5) (at pkg1 p2-4) (at pkg1 p3-3) (at pkg2 p4-5)
      (at pkg2 p1-2) (at pkg2 p5-6) (at pkg3 p5-5) (at pkg3 p6-5)
      (at pkg3 p2-4) (at pkg4 p2-1) (at pkg4 p6-3) (at pkg4 p3-2)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f))
               (union (collect f (del * f))
                      (union initial-state (union goal-state pref-fluents))))))
(domain costs (collect c (cost * c)))

;; Preferences (soft): violated exactly when the body fails;
;; (weight ...) charges the metric cost of each violation
(or (holds (at pkg1 p5-5) numslices) (pref-violated deliver-pkg1-1))
(or (not (holds (at pkg1 p5-5) numslices)) (not (pref-violated deliver-pkg1-1)))
(weight (pref-violated deliver-pkg1-1) 8)
(or (holds (at pkg1 p2-4) numslices) (pref-violated deliver-pkg1-2))
(or (not (holds (at pkg1 p2-4) numslices)) (not (pref-violated deliver-pkg1-2)))
(weight (pref-violated deliver-pkg1-2) 8)
(or (holds (at pkg1 p3-3) numslices) (pref-violated deliver-pkg1-3))
(or (not (holds (at pkg1 p3-3) numslices)) (not (pref-violated deliver-pkg1-3)))
(weight (pref-violated deliver-pkg1-3) 8)
(or (holds (at pkg2 p4-5) numslices) (pref-violated deliver-pkg2-1))
(or (not (holds (at pkg2 p4-5) numslices)) (not (pref-violated deliver-pkg2-1)))
(weight (pref-violated deliver-pkg2-1) 8)
(or (holds (at pkg2 p1-2) numslices) (pref-violated deliver-pkg2-2))
(or (not (holds (at pkg2 p1-2) numslices)) (not (pref-violated deliver-pkg2-2)))
(weight (pref-violated deliver-pkg2-2) 8)
(or (holds (at pkg2 p5-6) numslices) (pref-violated deliver-pkg2-3))
(or (not (holds (at pkg2 p5-6) numslices)) (not (pref-violated deliver-pkg2-3)))
(weight (pref-violated deliver-pkg2-3) 8)
(or (holds (at pkg3 p5-5) numslices) (pref-violated deliver-pkg3-1))
(or (not (holds (at pkg3 p5-5) numslices)) (not (pref-violated deliver-pkg3-1)))
(weight (pref-violated deliver-pkg3-1) 8)
(or (holds (at pkg3 p6-5) numslices) (pref-violated deliver-pkg3-2))
(or (not (holds (at pkg3 p6-5) numslices)) (not (pref-violated deliver-pkg3-2)))
(weight (pref-violated deliver-pkg3-2) 8)
(or (holds (at pkg3 p2-4) numslices) (pref-violated deliver-pkg3-3))
(or (not (holds (at pkg3 p2-4) numslices)) (not (pref-violated deliver-pkg3-3)))
(weight (pref-violated deliver-pkg3-3) 8)
(or (holds (at pkg4 p2-1) numslices) (pref-violated deliver-pkg4-1))
(or (not (holds (at pkg4 p2-1) numslices)) (not (pref-violated deliver-pkg4-1)))
(weight (pref-violated deliver-pkg4-1) 8)
(or (holds (at pkg4 p6-3) numslices) (pref-violated deliver-pkg4-2))
(or (not (holds (at pkg4 p6-3) numslices)) (not (pref-violated deliver-pkg4-2)))
(weight (pref-violated deliver-pkg4-2) 8)
(or (holds (at pkg4 p3-2) numslices) (pref-violated deliver-pkg4-3))
(or (not (holds (at pkg4 p3-2) numslices)) (not (pref-violated deliver-pkg4-3)))
(weight (pref-violated deliver-pkg4-3) 8)

(include "/Users/kautz/lib/fifo/lisp/satplan.wff")
