  (all veh vehicle true
   (all loc place true
    (and (pre (load obj veh loc) (at veh loc))
         (pre (load obj veh loc) (at obj loc))
         (add (load obj veh loc) (in obj veh))
         (del (load obj veh loc) (at obj loc)) (cost (load obj veh loc) 1)))))
 (all obj package true
  (all veh vehicle true
   (all loc place true
    (and (pre (unload obj veh loc) (at veh loc))
         (pre (unload obj veh loc) (in obj veh))
         (add (unload obj veh loc) (at obj loc))
         (del (unload obj veh loc) (in obj veh))
         (cost (unload obj veh loc) 1)))))
 (all truck-v truck true
  (all (from to) place true
   (if (and (road from to))
       (and (pre (drive truck-v from to) (at truck-v from))
            (add (drive truck-v from to) (at truck-v to))
            (del (drive truck-v from to) (at truck-v from))
            (cost (drive truck-v from to) 2)))))
 (all airplane-v airplane true
  (all (from to) airport true
   (if (and (route from to))
       (and (pre (fly airplane-v from to) (at airplane-v from))
            (add (fly airplane-v from to) (at airplane-v to))
            (del (fly airplane-v from to) (at airplane-v from))
            (cost (fly airplane-v from to) 3))))))

;; Initial and goal states
(domain initial-state
 (set (at pkg1 p5-13) (at pkg2 p2-8) (at pkg3 p3-14) (at pkg4 p15-1)
      (at truck1 p12-4) (at truck2 p2-1)))
(domain goal-state (set (at pkg1 p9-8)))
(domain pref-fluents
 (set (at pkg1 p15-7) (at pkg1 p9-8) (at pkg1 p2-6) (at pkg2 p9-14)
      (at pkg2 p14-10) (at pkg2 p9-1) (at pkg3 p3-8) (at pkg3 p3-10)
      (at pkg3 p9-9) (at pkg4 p5-7) (at pkg4 p13-1) (at pkg4 p11-6)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f))
               (union (collect f (del * f))
                      (union initial-state (union goal-state pref-fluents))))))
(domain costs (collect c (cost * c)))

;; Preferences (soft): violated exactly when the body fails;
;; (weight ...) charges the metric cost of each violation
(or (holds (at pkg1 p15-7) numslices) (pref-violated deliver-pkg1-1))
(or (not (holds (at pkg1 p15-7) numslices))
    (not (pref-violated deliver-pkg1-1)))
(weight (pref-violated deliver-pkg1-1) 8)
(or (holds (at pkg1 p9-8) numslices) (pref-violated deliver-pkg1-2))
(or (not (holds (at pkg1 p9-8) numslices)) (not (pref-violated deliver-pkg1-2)))
(weight (pref-violated deliver-pkg1-2) 8)
