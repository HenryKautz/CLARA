(or (not (holds (at pkg2 p9-1) numslices)) (not (pref-violated deliver-pkg2-3)))
(weight (pref-violated deliver-pkg2-3) 8)
(or (holds (at pkg3 p3-8) numslices) (pref-violated deliver-pkg3-1))
(or (not (holds (at pkg3 p3-8) numslices)) (not (pref-violated deliver-pkg3-1)))
(weight (pref-violated deliver-pkg3-1) 8)
(or (holds (at pkg3 p3-10) numslices) (pref-violated deliver-pkg3-2))
(or (not (holds (at pkg3 p3-10) numslices))
    (not (pref-violated deliver-pkg3-2)))
(weight (pref-violated deliver-pkg3-2) 8)
(or (holds (at pkg3 p9-9) numslices) (pref-violated deliver-pkg3-3))
(or (not (holds (at pkg3 p9-9) numslices)) (not (pref-violated deliver-pkg3-3)))
(weight (pref-violated deliver-pkg3-3) 8)
(or (holds (at pkg4 p5-7) numslices) (pref-violated deliver-pkg4-1))
(or (not (holds (at pkg4 p5-7) numslices)) (not (pref-violated deliver-pkg4-1)))
(weight (pref-violated deliver-pkg4-1) 8)
(or (holds (at pkg4 p13-1) numslices) (pref-violated deliver-pkg4-2))
