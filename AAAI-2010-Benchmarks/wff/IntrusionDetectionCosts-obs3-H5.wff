;; IntrusionDetectionCosts-obs3-H5: FiFO encoding of IntrusionDetectionCosts/problem.pddl, with the ordering evidence IntrusionDetectionCosts/evidence-3.txt, as the CLARA experiments built it
;; (recognize.sh --stop-after scnf; regenerated by make-fifo-files.py).
;; Self-contained: instantiating this file alone gives the clauses of
;; ../scnf/IntrusionDetectionCosts-obs3-H5.scnf.  The horizon:
(option *satplan-numslices* 5)

;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem intrusion-detection-10-hosts from IntrusionDetectionCosts-obs3-H5.pddl
;; Domain intrusion-detection from intrusion-detection-costs.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects
 (set perseus cassiopea andromeda sagittarius scorpio virgo aries leo libra
      taurus))

;; Type domains
(domain host
 (set perseus cassiopea andromeda sagittarius scorpio virgo aries leo libra
      taurus))

;; Static predicates (never added or deleted), with all
;; positive instances from the initial state.  The dummy
;; facts only register each predicate as static.
(static
 (occur-in-order pddl2fifo-static-dummy pddl2fifo-static-dummy
  pddl2fifo-static-dummy)
 (dummy) (dummy))

;; Action preconditions, effects, and costs
(static
 (all h host true
  (if (and (dummy))
      (and (add (recon h) (recon-performed h)) (cost (recon h) 1))))
 (all h host true
  (and (pre (information-gathering h) (recon-performed h))
       (add (information-gathering h) (information-gathered h))
       (cost (information-gathering h) 1)))
 (all h host true
  (and (pre (break-into h) (recon-performed h))
       (add (break-into h) (access-obtained h)) (cost (break-into h) 1)))
 (all h host true
  (and (pre (modify-files h) (access-obtained h))
       (add (modify-files h) (modified-files h)) (cost (modify-files h) 1)))
 (all h host true
  (and (pre (clean h) (access-obtained h)) (add (clean h) (deleted-logs h))
       (cost (clean h) 1)))
 (all h host true
  (and (pre (vandalize h) (modified-files h))
       (pre (vandalize h) (deleted-logs h)) (add (vandalize h) (vandalized h))
       (cost (vandalize h) 1)))
 (all h host true
  (and (pre (gain-root h) (access-obtained h))
       (add (gain-root h) (root-access-obtained h)) (cost (gain-root h) 1)))
 (all h host true
  (and (pre (download-files h) (root-access-obtained h))
       (add (download-files h) (files-downloaded h))
       (cost (download-files h) 1)))
 (all h host true
  (and (pre (steal-data h) (files-downloaded h))
       (pre (steal-data h) (deleted-logs h))
       (add (steal-data h) (data-stolen-from h)) (cost (steal-data h) 1))))

;; Initial and goal states

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f)) (collect f (del * f)))))
(domain costs (collect c (cost * c)))
(domain initial-state (set-difference fluents fluents))
(domain goal-state (set-difference fluents fluents))

;; Goal (disjunctive/nested) asserted directly at the final slice
(or (holds (hyp0) numslices) (holds (hyp1) numslices) (holds (hyp2) numslices)
    (holds (hyp3) numslices) (holds (hyp4) numslices) (holds (hyp5) numslices)
    (holds (hyp6) numslices) (holds (hyp7) numslices) (holds (hyp8) numslices)
    (holds (hyp9) numslices))

;; Derived predicate definitions (:derived)
(all s slices true
 (equiv (holds (hyp0) s)
  (and (holds (information-gathered perseus) s)
       (holds (information-gathered cassiopea) s)
       (holds (information-gathered andromeda) s)
       (holds (information-gathered sagittarius) s)
       (holds (information-gathered scorpio) s)
       (holds (information-gathered virgo) s)
       (holds (information-gathered aries) s)
       (holds (information-gathered leo) s)
       (holds (information-gathered libra) s)
       (holds (information-gathered taurus) s))))
(all s slices true
 (equiv (holds (hyp1) s)
  (and (holds (data-stolen-from perseus) s) (holds (data-stolen-from taurus) s)
       (holds (data-stolen-from aries) s))))
(all s slices true
 (equiv (holds (hyp2) s)
  (and (holds (vandalized perseus) s) (holds (vandalized taurus) s)
       (holds (vandalized leo) s))))
(all s slices true
 (equiv (holds (hyp3) s)
  (and (holds (data-stolen-from leo) s) (holds (data-stolen-from taurus) s)
       (holds (vandalized taurus) s))))
(all s slices true
 (equiv (holds (hyp4) s)
  (and (holds (vandalized virgo) s) (holds (data-stolen-from aries) s)
       (holds (data-stolen-from sagittarius) s))))
(all s slices true
 (equiv (holds (hyp5) s)
  (and (holds (data-stolen-from cassiopea) s)
       (holds (data-stolen-from libra) s) (holds (vandalized taurus) s))))
(all s slices true
 (equiv (holds (hyp6) s)
  (and (holds (vandalized libra) s) (holds (vandalized virgo) s)
       (holds (vandalized scorpio) s))))
(all s slices true
 (equiv (holds (hyp7) s)
  (and (holds (data-stolen-from andromeda) s) (holds (vandalized virgo) s)
       (holds (data-stolen-from aries) s))))
(all s slices true
 (equiv (holds (hyp8) s)
  (and (holds (vandalized sagittarius) s) (holds (vandalized scorpio) s)
       (holds (data-stolen-from virgo) s))))
(all s slices true
 (equiv (holds (hyp9) s)
  (and (holds (data-stolen-from perseus) s)
       (holds (data-stolen-from cassiopea) s) (holds (vandalized libra) s))))

(include "satplan.wff")

;; Observation-monitor axioms for the evidence in evidence-3.txt:
;; determined and count-neutral, so they condition on nothing.
;; planner.sh --split-evidence folds them into the theory; the
;; literal to condition on is in the scnf's -assertion.txt.
(and (not (obsdone 1 1 1)) (not (obsdone 1 2 1)) (not (obsdone 1 3 1))
     (all s actslices true
      (equiv (obsdone 1 1 (+ s 1)) (or (obsdone 1 1 s) (occurs (recon taurus) s))))
     (all s actslices true
      (equiv (obsdone 1 2 (+ s 1))
       (or (obsdone 1 2 s) (and (obsdone 1 1 s) (occurs (recon leo) s)))))
     (all s actslices true
      (equiv (obsdone 1 3 (+ s 1))
       (or (obsdone 1 3 s) (and (obsdone 1 2 s) (occurs (recon virgo) s))))))
