;; BlocksWorldCosts-obs3: FiFO encoding of BlocksWorldCosts/problem.pddl, with the ordering evidence BlocksWorldCosts/evidence-3.txt, as the CLARA experiments built it
;; (recognize.sh --stop-after scnf; regenerated by make-fifo-files.py).
;; Self-contained: instantiating this file alone gives the clauses of
;; ../scnf/BlocksWorldCosts-obs3.scnf.  The horizon:
(option *satplan-numslices* 15)

;; FiFO SatPlan encoding generated by pddl2fifo
;; Problem blocks_words from BlocksWorldCosts-obs3.pddl
;; Domain blocks from block-words-costs.pddl

;; Time horizon -- numslices is taken from the Lisp variable
;; *satplan-numslices* when it is bound to an integer, else 2.
(alias numslices
 (lisp
  (if (and (boundp '*satplan-numslices*)
           (integerp (symbol-value '*satplan-numslices*)))
      (symbol-value '*satplan-numslices*)
      2)))
(domain slices (range 1 numslices))
(domain actslices (range 1 (- numslices 1)))

;; Objects
(domain objects (set d r a w o e p c))

;; Type domains
(domain block (set d r a w o e p c))

;; Static predicates (never added or deleted), with all
;; positive instances from the initial state.  The dummy
;; facts only register each predicate as static.
(static
 (occur-in-order pddl2fifo-static-dummy pddl2fifo-static-dummy
  pddl2fifo-static-dummy))

;; Action preconditions, effects, and costs
(static
 (all x block true
  (and (pre (pick-up x) (clear x)) (pre (pick-up x) (ontable x))
       (pre (pick-up x) (handempty)) (add (pick-up x) (holding x))
       (del (pick-up x) (ontable x)) (del (pick-up x) (clear x))
       (del (pick-up x) (handempty)) (cost (pick-up x) 1)))
 (all x block true
  (and (pre (put-down x) (holding x)) (add (put-down x) (clear x))
       (add (put-down x) (handempty)) (add (put-down x) (ontable x))
       (del (put-down x) (holding x)) (cost (put-down x) 1)))
 (all (x y) block true
  (and (pre (stack x y) (holding x)) (pre (stack x y) (clear y))
       (add (stack x y) (clear x)) (add (stack x y) (handempty))
       (add (stack x y) (on x y)) (del (stack x y) (holding x))
       (del (stack x y) (clear y)) (cost (stack x y) 1)))
 (all (x y) block true
  (and (pre (unstack x y) (on x y)) (pre (unstack x y) (clear x))
       (pre (unstack x y) (handempty)) (add (unstack x y) (holding x))
       (add (unstack x y) (clear y)) (del (unstack x y) (clear x))
       (del (unstack x y) (handempty)) (del (unstack x y) (on x y))
       (cost (unstack x y) 1))))

;; Initial and goal states
(domain initial-state
 (set (handempty) (clear o) (ontable o) (clear r) (on r p) (ontable p)
      (clear e) (ontable e) (clear d) (on d a) (on a c) (ontable c) (clear w)
      (ontable w)))

;; Domains derived from the static action schemas
(domain actions
 (union (collect a (pre a *))
        (union (collect a (add a *)) (collect a (del a *)))))
(domain fluents
 (union (collect f (pre * f))
        (union (collect f (add * f))
               (union (collect f (del * f)) initial-state))))
(domain costs (collect c (cost * c)))
(domain goal-state (set-difference fluents fluents))

;; Goal (disjunctive/nested) asserted directly at the final slice
(or (holds (hyp0) numslices) (holds (hyp1) numslices) (holds (hyp2) numslices)
    (holds (hyp3) numslices) (holds (hyp4) numslices) (holds (hyp5) numslices)
    (holds (hyp6) numslices) (holds (hyp7) numslices) (holds (hyp8) numslices)
    (holds (hyp9) numslices) (holds (hyp10) numslices)
    (holds (hyp11) numslices) (holds (hyp12) numslices)
    (holds (hyp13) numslices) (holds (hyp14) numslices)
    (holds (hyp15) numslices) (holds (hyp16) numslices)
    (holds (hyp17) numslices) (holds (hyp18) numslices)
    (holds (hyp19) numslices) (holds (hyp20) numslices))

;; Derived predicate definitions (:derived)
(all s slices true
 (equiv (holds (hyp0) s)
  (and (holds (clear d) s) (holds (ontable w) s) (holds (on d r) s)
       (holds (on r a) s) (holds (on a w) s))))
(all s slices true
 (equiv (holds (hyp1) s)
  (and (holds (clear w) s) (holds (ontable r) s) (holds (on w a) s)
       (holds (on a r) s))))
(all s slices true
 (equiv (holds (hyp2) s)
  (and (holds (clear r) s) (holds (ontable w) s) (holds (on r a) s)
       (holds (on a w) s))))
(all s slices true
 (equiv (holds (hyp3) s)
  (and (holds (clear w) s) (holds (ontable d) s) (holds (on w a) s)
       (holds (on a d) s))))
(all s slices true
 (equiv (holds (hyp4) s)
  (and (holds (clear c) s) (holds (ontable w) s) (holds (on c r) s)
       (holds (on r o) s) (holds (on o w) s))))
(all s slices true
 (equiv (holds (hyp5) s)
  (and (holds (clear r) s) (holds (ontable w) s) (holds (on r o) s)
       (holds (on o w) s))))
(all s slices true
 (equiv (holds (hyp6) s)
  (and (holds (clear w) s) (holds (ontable r) s) (holds (on w e) s)
       (holds (on e a) s) (holds (on a r) s))))
(all s slices true
 (equiv (holds (hyp7) s)
  (and (holds (clear e) s) (holds (ontable r) s) (holds (on e a) s)
       (holds (on a r) s))))
(all s slices true
 (equiv (holds (hyp8) s)
  (and (holds (clear p) s) (holds (ontable r) s) (holds (on p e) s)
       (holds (on e a) s) (holds (on a r) s))))
(all s slices true
 (equiv (holds (hyp9) s)
  (and (holds (clear r) s) (holds (ontable e) s) (holds (on r o) s)
       (holds (on o p) s) (holds (on p e) s))))
(all s slices true
 (equiv (holds (hyp10) s)
  (and (holds (clear d) s) (holds (ontable e) s) (holds (on d o) s)
       (holds (on o p) s) (holds (on p e) s))))
(all s slices true
 (equiv (holds (hyp11) s)
  (and (holds (clear d) s) (holds (ontable r) s) (holds (on d e) s)
       (holds (on e a) s) (holds (on a r) s))))
(all s slices true
 (equiv (holds (hyp12) s)
  (and (holds (clear w) s) (holds (ontable e) s) (holds (on w o) s)
       (holds (on o r) s) (holds (on r e) s))))
(all s slices true
 (equiv (holds (hyp13) s)
  (and (holds (clear p) s) (holds (ontable r) s) (holds (on p o) s)
       (holds (on o w) s) (holds (on w e) s) (holds (on e r) s))))
(all s slices true
 (equiv (holds (hyp14) s)
  (and (holds (clear r) s) (holds (ontable p) s) (holds (on r e) s)
       (holds (on e a) s) (holds (on a p) s))))
(all s slices true
 (equiv (holds (hyp15) s)
  (and (holds (clear c) s) (holds (ontable r) s) (holds (on c o) s)
       (holds (on o w) s) (holds (on w e) s) (holds (on e r) s))))
(all s slices true
 (equiv (holds (hyp16) s)
  (and (holds (clear c) s) (holds (ontable e) s) (holds (on c o) s)
       (holds (on o r) s) (holds (on r e) s))))
(all s slices true
 (equiv (holds (hyp17) s)
  (and (holds (clear p) s) (holds (ontable e) s) (holds (on p o) s)
       (holds (on o r) s) (holds (on r e) s))))
(all s slices true
 (equiv (holds (hyp18) s)
  (and (holds (clear w) s) (holds (ontable e) s) (holds (on w a) s)
       (holds (on a d) s) (holds (on d e) s))))
(all s slices true
 (equiv (holds (hyp19) s)
  (and (holds (clear p) s) (holds (ontable w) s) (holds (on p a) s)
       (holds (on a w) s))))
(all s slices true
 (equiv (holds (hyp20) s)
  (and (holds (clear r) s) (holds (ontable e) s) (holds (on r a) s)
       (holds (on a p) s) (holds (on p e) s))))

(include "satplan.wff")

;; Observation-monitor axioms for the evidence in evidence-3.txt:
;; determined and count-neutral, so they condition on nothing.
;; planner.sh --split-evidence folds them into the theory; the
;; literal to condition on is in the scnf's -assertion.txt.
(and (not (obsdone 1 1 1)) (not (obsdone 1 2 1)) (not (obsdone 1 3 1))
     (all s actslices true
      (equiv (obsdone 1 1 (+ s 1)) (or (obsdone 1 1 s) (occurs (unstack r p) s))))
     (all s actslices true
      (equiv (obsdone 1 2 (+ s 1))
       (or (obsdone 1 2 s) (and (obsdone 1 1 s) (occurs (pick-up o) s)))))
     (all s actslices true
      (equiv (obsdone 1 3 (+ s 1))
       (or (obsdone 1 3 s) (and (obsdone 1 2 s) (occurs (unstack d a) s))))))
